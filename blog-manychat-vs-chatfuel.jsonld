    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is Chatfuel cheaper than ManyChat?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Published subscription prices differ, but the total depends on contact limits, feature access, monthly credits, wallet deductions, Meta message charges, taxes and billing period. A subscription-only comparison is not an all-in answer."
        }
      },
      {
        "@type": "Question",
        "name": "Can I compare Chatora’s price with ManyChat and Chatfuel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Chatora has no published subscription price or live messaging channel, so there is no equivalent plan or usage total to compare."
        }
      },
      {
        "@type": "Question",
        "name": "Do contacts automatically transfer when I switch providers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Do not assume that they do. Export and back up the records available from your current provider and verify the channel’s ownership and transfer rules before disconnecting it."
        }
      },
      {
        "@type": "Question",
        "name": "Where can I see Chatora’s current availability?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The pricing page states what is and is not enabled in the current preview. It does not publish a paid plan or promise live channel messaging."
        }
      }
    ]
