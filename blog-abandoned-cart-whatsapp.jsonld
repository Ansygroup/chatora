  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many messages should an abandoned-cart flow have?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "There is no universal best number. Start with the smallest sequence that meets the customer need, then test timing and frequency within consent and platform rules while monitoring opt-outs and complaints."
        }
      },
      {
        "@type": "Question",
        "name": "Does an abandoned-cart WhatsApp flow need a discount?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not always. A discount can reduce margin; compare it with an informative reminder and measure attributable orders and contribution margin before deciding."
        }
      },
      {
        "@type": "Question",
        "name": "Is an abandoned-cart message Marketing or Utility on WhatsApp?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not automatically Utility. Meta’s approved category depends on message content and current rules. A promotional cart reminder may be Marketing; do not label it Utility just because a cart exists."
        }
      }
    ]
  },
