{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatora",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
