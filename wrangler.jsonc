{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatora",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL", "destination_address": "livepm8@gmail.com" }],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
